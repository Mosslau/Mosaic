{
  "uid": "realtime-metrics",
  "title": "realtime 实时指标（在线数 / 故障 / 高温电池）",
  "tags": ["oceanverse", "realtime"],
  "timezone": "",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "最新窗口在线数",
      "description": "ads_vehicle_online_1m 的最后一个窗口。口径=窗口内上报过的去重车辆数（活跃车辆近似值, 不是 MQTT 长连接数; 见 warehouse/streaming/README §2）。若长时间不更新, 先看 Flink 作业是否还在跑。",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 7 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ov-clickhouse" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ov-clickhouse" },
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT window_start AS t, online_cnt FROM oceanverse.ads_vehicle_online_1m ORDER BY t"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "在线数趋势（每分钟）",
      "description": "每个点=该分钟窗口内上报过的去重车辆数。掉到 0 说明链路断了(而不是车都下线了)——先查 Flink 作业与消费。",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 7 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ov-clickhouse" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "showPoints": "auto", "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ov-clickhouse" },
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT window_start AS t, online_cnt FROM oceanverse.ads_vehicle_online_1m ORDER BY t"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "故障数（按 fault_code）",
      "description": "已按 (vin, ts, code) 去重 —— 故障走 QoS1, 不去重会把一次故障算成多次。某码突然抬高通常是批量问题(批次/固件/BMS 版本)。",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ov-clickhouse" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ov-clickhouse" },
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT window_start AS t, code, sum(fault_cnt) AS fault_cnt FROM oceanverse.ads_fault_count_1m GROUP BY t, code ORDER BY t"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "高温电池告警（level=alarm, ≥55℃）",
      "description": "窗口内每车最高电池温度 ≥55℃。warn(≥45) 也在表里可查, 这里只列 alarm 以免淹没。阈值口径见 warehouse/streaming/README §2。",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ov-clickhouse" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "temp_max" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }, { "color": "red", "value": 55 }] } }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ov-clickhouse" },
          "queryType": "sql",
          "format": 2,
          "rawSql": "SELECT window_start, vin, temp_max, level FROM oceanverse.ads_high_temp_battery_1m WHERE level = 'alarm' ORDER BY window_start DESC, temp_max DESC LIMIT 100"
        }
      ]
    }
  ]
}
