  "cards": [
    {
      "dot": "cyan",
      "title": "数据面（D2 / D3 / D4 / D6 / D9）",
      "items": [
        "湖为真相源，Doris 只做 serving",
        "语义层唯一口径：metric_def + MQL→SQL",
        "接入走 SeaTunnel，DLQ 按原因枚举"
      ]
    },
    {
      "dot": "violet",
      "title": "控制面（D5 / D7 / D8 / D11）",
      "items": [
        "12 个控制中心分落 D5 / D6 / D7 / D8 / D11",
        "先能管才能放：D8 必须在 D9 之前",
        "D11 只做跨域控制面，不重复 D5 的调度"
      ]
    },
    {
      "dot": "amber",
      "title": "基础设施与边界",
      "items": [
        "Kafka / MinIO / Iceberg / Doris / Flink / Spark / PG / Redis / K8s",
        "不造全家桶：调度 / 集成 / 湖表 / 目录 / 语义引擎用成熟件",
        "模型网关 / MCP / 沙箱归 AI 平台，本平台只调用"
      ]
    }
