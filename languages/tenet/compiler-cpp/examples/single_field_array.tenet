// S3c-3b-3：单字段 struct 数组 array<P, 1> 与内层 1 槽的嵌套数组。
// 是否走扁平槽路径按元素种类（struct / array）判断，不看元素槽数，
// 因此 slots == 1 的数组不会被误判成标量数组。
struct P { x: int; }

fn one(a: array<P, 1>) -> array<P, 1> {
    a[0].x = a[0].x + 1;
    return a;
}

fn nid(a: array<array<int, 1>, 2>) -> array<array<int, 1>, 2> { return a; }

// array<P,1>：局部 / 参数 / 返回值 / 字段读写 / 元素赋值
let a: array<P, 1> = [P { x: 1 }];
a[0] = P { x: 2 };
a[0].x = 3;
let b: array<P, 1> = one(a);
print(a[0].x, b[0].x);              // 3 4

// array<array<int,1>,M>：内层 1 槽仍按嵌套数组扁平槽读写
let n: array<array<int, 1>, 2> = [[1], [2]];
n[0][0] = 9;
let m: array<array<int, 1>, 2> = nid(n);
m[1][0] = 7;
print(n[0][0], n[1][0], m[0][0], m[1][0]);  // 9 2 9 7
