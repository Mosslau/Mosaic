// S3c-3c v1：固定嵌套数组 array<array<T, N>, M>（仅局部变量）。
// 存储为扁平 [M*N x i64]，外层第 i 个元素占连续 N 个 8 字节槽；
// 内层元素限 int/float，a[i][j] 读写带外层 + 内层运行时边界检查。
let a: array<array<int, 2>, 3> = [[1, 2], [3, 4], [5, 6]];
a[0][1] = 9;
a[2][0] = 7;
print(a[0][0], a[0][1], a[1][1], a[2][0], a[2][1]);  // 1 9 4 7 6

// 深拷贝：b 有独立扁平缓冲；len 仍是外层编译期常量
let b = a;
b[1][1] = 100;
print(a[1][1], b[1][1], len(a));        // 4 100 3

// 动态下标：外层与内层都做边界检查
let i: int = 2;
let j: int = 1;
print(a[i][j]);                          // 6
a[i][0] = 8;
print(a[2][0]);                          // 8

// 内层 float 同样按 8 字节槽 bitcast 打包/解包
let f: array<array<float, 2>, 2> = [[1.5, 2.5], [3.5, 4.5]];
print(f[0][0], f[1][1]);                // 1.5 4.5
