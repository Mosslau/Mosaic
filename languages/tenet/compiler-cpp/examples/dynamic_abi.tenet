// S3c-2：动态数组参数 / 返回值（3 槽 descriptor / 隐藏 sret）
// 参数：调用方传 descriptor（data/len/cap），被调函数入口深拷贝（值语义）
// 返回：隐藏 %sret descriptor，return 变量转移所有权并清空本地槽位
fn sum(a: array<int>) -> int {
    let s: int = 0;
    let i: int = 0;
    while (i < len(a)) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

// 函数内 push 只改参数副本，调用方数组不受影响
fn bump(a: array<int>) -> int {
    push(a, 99);
    return len(a);
}

// 返回参数：入口深拷贝的缓冲区所有权转移给调用方
fn clone(a: array<int>) -> array<int> {
    return a;
}

// 返回局部变量：data/len/cap 写入 sret 后清空本地槽位，避免 double free
fn build() -> array<int> {
    let a: array<int> = [4, 5];
    push(a, 6);
    return a;
}

let a: array<int> = [1, 2];
let s: int = sum(a);
let n: int = bump(a);
let b: array<int> = clone(a);
push(b, 3);
let c: array<int> = build();
a[0] = 9;

print(s, len(a), a[0]);       // 3 2 9：sum 读的是入口副本；a 自己仍是 2 个元素
print(n, len(a));             // 3 2：bump 内 push 不影响调用方
print(len(b), b[0], b[2]);    // 3 1 3：b 接管 clone 返回的缓冲区
print(len(c), c[0], c[2]);    // 3 4 6：build 返回局部动态数组
