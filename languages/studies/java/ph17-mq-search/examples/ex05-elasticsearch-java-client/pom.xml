<?xml version="1.0" encoding="UTF-8"?>
<!-- examples/ex05-elasticsearch-java-client/pom.xml —— ES 8.x 官方 Java client 检索（主文档 3.8/3.9）
     验证环境：OpenJDK 17 + Maven 3.9 + Spring Boot 3.3.0 父 POM（依赖管理基线）
     依赖：co.elastic.clients:elasticsearch-java 8.13.4（不在本机离线缓存，首次需联网拉取）
     验证命令：mvn -o -Dmaven.repo.local=/tmp/m2clone spring-boot:run -Dspring-boot.run.main-class=com.example.ex05.EsSearchDemo
               （联网环境去掉 -o 参数）
     前置条件：本目录 docker-compose.yml 已起 ES（docker compose up -d elasticsearch）
     验证状态：未在本环境验证（需本地 ES 服务，见 examples/README.md） -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>ex05-elasticsearch-java-client</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>17</java.version>
    <elasticsearch.version>8.13.4</elasticsearch.version>
  </properties>

  <dependencies>
    <!-- ES 8.x 官方 Java API client（底层 elasticsearch-rest-client + JacksonJsonpMapper 随依赖带入）；
         RestHighLevelClient 已在 8.0 移除，别再用老坐标 -->
    <dependency>
      <groupId>co.elastic.clients</groupId>
      <artifactId>elasticsearch-java</artifactId>
      <version>${elasticsearch.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 用 spring-boot:run 拉起任意 main-class（本项目没有 Spring 上下文，只借类路径管理） -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
