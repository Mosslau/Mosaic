<?xml version="1.0" encoding="UTF-8"?>
<!-- examples/ex01-spring-data-redis-cache/pom.xml —— Redis 数据结构与缓存用法（主文档 3.1/3.3/3.4）
     验证环境：OpenJDK 17 + Maven 3.9 + Spring Boot 3.3.0（依赖管理基线，与 ph14/ph15/ph16/ph17 同源）
     依赖：spring-boot-starter-data-redis（Boot 管理，默认 Lettuce 客户端）
     验证命令：mvn -o -Dmaven.repo.local=/tmp/m2clone spring-boot:run
               （联网环境去掉 -o 参数；需本地 Redis，见 examples/README.md）
     前置条件：本目录上级 docker-compose.yml 已起 Redis（docker compose up -d redis）
     验证状态：未在本环境验证（需本地 Redis 服务，见 examples/README.md） -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>ex01-spring-data-redis-cache</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.example.ex01.Ex01Application</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
