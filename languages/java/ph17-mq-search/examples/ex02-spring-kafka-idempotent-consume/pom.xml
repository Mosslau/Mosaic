<?xml version="1.0" encoding="UTF-8"?>
<!-- examples/ex02-spring-kafka-idempotent-consume/pom.xml —— spring-kafka 注解式可靠消费 + 幂等去重（主文档 3.2/3.4）
     验证环境：OpenJDK 17 + Maven 3.9 + Spring Boot 3.3.0（父 POM 管理 spring-kafka 3.2.0）
     验证命令：mvn -o -Dmaven.repo.local=/tmp/m2clone spring-boot:run -Dspring-boot.run.main-class=com.example.ex02.Ex02Application
               （另开终端用 ex01 的 ProducerMain 连发两遍同 key 消息观察去重；联网环境去掉 -o 参数）
     前置条件：本目录 docker-compose.yml 已起 Kafka（docker compose up -d kafka）
     验证状态：未在本环境验证（需本地 Kafka 服务，见 examples/README.md） -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>ex02-spring-kafka-idempotent-consume</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- spring-kafka：@KafkaListener + KafkaTemplate，版本由 Boot 3.3.0 BOM 管理（3.2.0） -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- 消息体 JSON 解析 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
