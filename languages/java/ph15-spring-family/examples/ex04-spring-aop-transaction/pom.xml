<?xml version="1.0" encoding="UTF-8"?>
<!-- examples/ex04-spring-aop-transaction/pom.xml —— AOP 切面 + @Transactional 事务（纯核心容器，无 Web）
     验证环境：OpenJDK 17.0.18 + Maven 3.9.12 + Spring Framework 6.1.8 / AspectJ 1.9.22 / HSQLDB 2.5.0
     验证命令：mvn -o -Dmaven.repo.local=/tmp/m2clone test
     离线说明：缓存缺 junit-platform-launcher 1.10.2（默认版本），钉到 1.10.1；surefire 3.2.5 显式钉住；
               hsqldb 版本钉到缓存有的 2.5.0（Boot 3.3.0 默认管 2.7.2，缓存缺）。联网环境可删仲裁项。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>ex04-spring-aop-transaction</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit.platform</groupId>
        <artifactId>junit-platform-launcher</artifactId>
        <version>1.10.1</version>
      </dependency>
      <dependency>
        <groupId>org.hsqldb</groupId>
        <artifactId>hsqldb</artifactId>
        <version>2.5.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- AOP 基础设施：spring-aop + aspectjweaver（Boot 3.3.0 管 AspectJ 1.9.22，在离线缓存） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- JDBC + 事务：JdbcTemplate / DataSourceTransactionManager / DataSourceInitializer 都在 spring-jdbc -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <!-- 连接池：REQUIRES_NEW 要挂起/恢复事务并新开连接，用 Hikari 池保证 mem 库连接不断（Boot BOM 管 5.1.0） -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <dependencies>
          <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.1</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
