// Tenet 控制流示例：FizzBuzz（while + if/else if/else）
// 运行：cargo run -- run examples/fizzbuzz.tenet

let n: int = 1;
while (n <= 20) {
    if (n % 15 == 0) {
        print("FizzBuzz");
    } else if (n % 3 == 0) {
        print("Fizz");
    } else if (n % 5 == 0) {
        print("Buzz");
    } else {
        print(n);
    }
    n = n + 1;
}
