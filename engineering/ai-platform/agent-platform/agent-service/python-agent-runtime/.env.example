# data-agent-runtime 生产环境配置样例
#
# 本文件是完整的生产部署参考，不包含任何真实凭证。所有 EXAMPLE_ONLY_* 值都必须
# 在部署前由 Secret Manager、Kubernetes Secret 或 CI/CD Secret 注入替换，不能直接
# 用于生产启动。这里不留空，是为了展示每个生产配置项的完整格式。
#
# 配置优先级：进程环境变量 > DATA_AGENT_ENV_FILE 指定文件 > 默认 .env/.env.local >
# 代码默认值。直接启动时默认读取 .env 和 .env.local；如需使用本文件或 .env.prod，
# 请显式设置 DATA_AGENT_ENV_FILE=.env.example 或 DATA_AGENT_ENV_FILE=.env.prod。生产建议
# 不要把本文件直接作为 Secret 文件挂载，而是把非敏感配置写入 ConfigMap，把敏感配置分别注入。
# API 和 Worker 可以共用一份配置；生产建议分别覆盖 RUNTIME_MODE、
# SERVICE_INSTANCE_ID 和 TASK_CONSUMER_NAME。
#
# Runtime 只支持多调用方 AK/SK + HMAC-SHA256；所有调用方必须注册在同一凭证注册表中。
# 多凭证注册表中的每个 access_key 都必须唯一，Secret 只能通过 Secret 注入。

# =============================================================================
# 一、应用服务与日志
# =============================================================================

# 服务名称，用于健康检查、日志、Trace 和指标标签。
APP_NAME=data-agent-runtime

# 运行环境标识，同时参与安全策略分支，不只是日志标签：
# - local/dev/development/test：用于本地或测试联调；只有在 PUBLIC_MODE=false 时才允许
#   localhost/私网 MCP，且本地 HTTP MCP/Skill 仅在允许的开发环境分支中放行。
# - staging/prod/production：按生产级规则处理，HMAC 入站请求强制使用 HTTPS，
#   HTTP MCP/Skill、非 HTTPS Sandbox Gateway 等会被拒绝，并启用生产凭证与白名单要求。
# 生产必须设置为 prod 或 production；本地 HTTP 联调应设置为 local，不能只把
# HMAC_REQUIRE_HTTPS 改为 false 来绕过生产级 HTTPS 判断。
APP_ENV=production

# FastAPI/Uvicorn 监听地址。容器部署通常使用 0.0.0.0；本地可改为 127.0.0.1。
HOST=0.0.0.0

# Runtime API 监听端口。API 与 Worker 共用配置时，Worker 不会监听 HTTP 端口。
PORT=8800

# 日志级别：DEBUG、INFO、WARNING、ERROR。生产环境建议 INFO 或 WARNING。
LOG_LEVEL=INFO

# 是否输出 JSON 结构化日志。生产环境必须保持 true。
LOG_JSON=true

# 是否对日志消息、异常、Header、连接串和结构化字段执行脱敏。生产环境必须保持 true。
LOG_REDACTION_ENABLED=true

# 当前进程实例标识。留空时由 Runtime/部署系统生成；生产建议注入 Pod 或主机标识。
SERVICE_INSTANCE_ID=runtime-api-prod-01

# =============================================================================
# 二、Runtime 入站认证与跨域配置
# =============================================================================

# 多调用方 AK/SK 注册表；每个 access_key 映射一个可信 Principal、租户、用户、角色、Scope
# 和配额。API 认证、租户隔离、资源所有权和并发限制都依赖这里的映射；请求体中的
# user_context 不能覆盖 Principal。所有调用方必须独立注册，不能退回固定 Token 或单 AK/SK。
# Secret 只能由 Secret Manager/Kubernetes Secret 注入，不能提交到 Git 或写入 Snapshot。
# [{"access_key":"caller-a","secret_key":"...","principal_id":"caller-a","tenant_id":"tenant-a","scopes":["runs:write","runs:read"]}]
INTERNAL_SERVICE_CREDENTIALS_JSON='[ {"access_key":"caller-java-prod","secret_key":"EXAMPLE_ONLY_java_secret_replace_via_secret_manager","principal_id":"java-control-plane","tenant_id":"tenant-java","roles":["runtime:caller"],"scopes":["runs:write","runs:read","runs:cancel","runs:approve","sessions:read","sessions:write","memory:read","memory:write"]},{"access_key":"caller-web-prod","secret_key":"EXAMPLE_ONLY_web_secret_replace_via_secret_manager","principal_id":"web-control-plane","tenant_id":"tenant-web","roles":["runtime:caller"],"scopes":["runs:write","runs:read","sessions:read"]} ]'

# 公共 Runtime 安全边界，不表示匿名访问；无论取值如何，调用方仍必须通过 AK/SK +
# HMAC-SHA256、Timestamp、Nonce、Body Hash、Scope 和 Principal 认证授权。
# false：适合受控本地联调，可使用 localhost MCP、内联 Skill 和本地 HTTP（还需 APP_ENV
# 为 local/dev/development 且 HMAC_REQUIRE_HTTPS=false）。
# true：面向第三方或不完全受信任调用方，强制租户/用户归属与 Snapshot Admission；
# 拒绝 stdio/localhost/私网 MCP、要求 ALLOWED_MCP_HOSTS、禁止内联 MCP Header，
# 要求 Skill 使用 bundle_url + sha256，禁止 full Sandbox 网络。生产必须为 true。
PUBLIC_MODE=true

# 签名请求的传输层要求。生产环境必须为 true；并且 APP_ENV=prod/production/staging 时
# 代码会无条件强制 HTTPS，即使这里误设为 false 也不会放行 HTTP。只有 local/dev/
# development/test 的本地联调路径才可以设置为 false；HTTPS 终止在反向代理时，必须确保
# Runtime 能正确识别转发后的 HTTPS Scheme。
HMAC_REQUIRE_HTTPS=true

# HMAC Timestamp 的允许时钟偏差，单位为秒；调用方和 Runtime 必须保持时钟同步。该值
# 决定签名请求的有效时间窗口，不能替代 Nonce 防重放；应与 HMAC_NONCE_TTL_SECONDS、
# 网关/代理超时和客户端重试策略一起规划，过大将扩大失窃请求的可利用窗口。
HMAC_CLOCK_SKEW_SECONDS=300

# Nonce 防重放记录 TTL，单位为秒；需要 API 实例共享的 Redis 才能保证多实例间只接受
# 一次请求。TTL 不应短于 Timestamp 的有效窗口，否则 Nonce 过期后仍可能在时间窗口内重放；
# Redis 不可用时，认证请求会被拒绝，而不是降级为无防重放模式。
HMAC_NONCE_TTL_SECONDS=300

# 浏览器跨域来源白名单；它只控制 CORS，不等于认证授权，也不能绕过 HMAC。浏览器
# 不应长期持有 Secret Key，生产应由可信后端 Caller/SSE Gateway 完成签名；本地页面可以
# 配置 localhost/127.0.0.1，生产只能填写受信任的 HTTPS 前端域名，禁止使用 *。
CORS_ALLOWED_ORIGINS=https://console.example.com

# =============================================================================
# 三、Redis、会话、事件和 Checkpoint
# =============================================================================

# API 和 Worker 必须连接同一个 Redis；Redis Stream 用于任务队列和事件，另外还保存
# Run/Session Lease、Nonce 防重放、并发配额、会话历史和运行状态。用户名/密码、TLS
# 协议（redis:// 或 rediss://）必须与 Redis 部署一致；连接失败会导致 API/Worker
# 无法就绪，且 HMAC Nonce 防重放不能工作。生产密码必须通过 Secret 注入。
# 示例格式：redis://用户名:密码@主机:6379/0 或 rediss://用户名:密码@主机:6380/0。
REDIS_URL=rediss://runtime_redis:EXAMPLE_ONLY_redis_password@redis.example.com:6380/0

# 每个 Run 的事件 Stream 最大长度。过小会影响历史事件读取，过大增加 Redis 占用。
EVENT_STREAM_MAXLEN=10000

# Runtime 从 Redis 注入 Prompt 的最大会话消息数。
CONVERSATION_HISTORY_MAX_MESSAGES=100

# 注入 Prompt 的长期记忆最大条数。
LONG_TERM_MEMORY_MAX_ITEMS=50

# LangGraph Checkpointer 后端：memory 只保存在当前进程内，适合本地单进程验证；postgres
# 用于生产、API/Worker 分离和多 Worker，启动时会连接数据库并执行 Checkpointer 初始化。
# 选择 postgres 时 POSTGRES_DSN 必须可访问且具备建表/初始化权限；选择 memory 时会话
# Checkpoint 不跨进程、不跨重启持久化，不能作为生产配置。
CHECKPOINT_BACKEND=postgres

# Agent 的跨会话键值存储（LangGraph BaseStore），用于跨 Run 读取的记忆与产物：
#   none      不创建 store（Agent 无法使用 store 相关能力）。
#   memory    进程内存储；仅单进程/本地联调可用，重启即失。
#   postgres  持久存储，复用下方 POSTGRES_DSN。
AGENT_STORE_BACKEND=postgres

# 仅当 CHECKPOINT_BACKEND=postgres 时生效且必填；API 和 Worker 都会使用它。生产建议使用
# 独立数据库/Schema、TLS 和最小权限账号，密码通过 Secret 注入；不要把真实 DSN 提交到 Git。
POSTGRES_DSN=postgresql://runtime_checkpoint:EXAMPLE_ONLY_postgres_password@postgres.example.com:5432/agent_runtime

# =============================================================================
# 四、模型服务（OpenAI-compatible API）
# =============================================================================

# 模型调用 Provider 标识。当前内置适配器支持 openai、openai-compatible 和 deepseek；
# deepseek 使用同一个 OpenAI-compatible 客户端，并通过 OPENAI_BASE_URL 指向 DeepSeek
# 或企业兼容网关。该值还必须出现在 ALLOWED_MODEL_PROVIDERS 中，并与 AgentSnapshot
# 的 model.provider 保持一致；ALLOWED_MODEL_PROVIDERS 只是部署白名单，不会动态安装适配器。
MODEL_PROVIDER=openai-compatible

# OPENAI_BASE_URL 对应的模型名称；模型名称还必须通过 ALLOWED_MODEL_NAMES（如果配置）
# 和服务端实际模型校验，否则请求可能在 Admission 或模型调用阶段失败。
MODEL_NAME=gpt-4o-mini

# 模型服务 API Key。生产必须通过 Secret 注入；本地未配置时模型调用会失败并明确报错。
OPENAI_API_KEY=EXAMPLE_ONLY_model_api_key_replace_via_secret_manager

# OpenAI-compatible API 根地址，例如 https://api.openai.com/v1 或企业模型网关地址。
OPENAI_BASE_URL=https://model-gateway.example.com/v1

# 模型采样温度。数据分析场景建议 0.0～0.3。
MODEL_TEMPERATURE=0.1

# =============================================================================
# Redis 客户端韧性与优雅停机
# =============================================================================

# 单次 Redis 读写/建连超时；没有超时时，网络抖动会让 API 或 Worker 永久阻塞。
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5.0
# 客户端重试次数与指数退避（避免抖动瞬间放大成大量失败）。
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_BACKOFF_BASE_SECONDS=0.05
REDIS_RETRY_BACKOFF_CAP_SECONDS=1.0
# 连接健康检查间隔与连接池上限。
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# 入口限流与背压
# =============================================================================

# =============================================================================
# 附件上传（表格 / PDF / 图片）
# =============================================================================

# 单文件大小上限（字节）；超过返回 413。
MAX_UPLOAD_BYTES=10485760
# 上传文件保留时长（秒）；Run 执行时按 file_id 读取，过期即失效。
UPLOAD_TTL_SECONDS=3600
# 单次 Run 最多附件数。
MAX_ATTACHMENTS=5
# 注入模型的附件文本上限与表格预览行数。
ATTACHMENT_MAX_CHARS=20000
ATTACHMENT_PREVIEW_ROWS=20
# 允许图片输入的模型名白名单（逗号分隔），必须与 Snapshot 的 model.name 一致。
# 生产样例不保留空值；若不需要图片输入，请填写一个不会被使用的占位模型名。
ALLOWED_VISION_MODELS=vision-capable-model-name

# 每个调用方每分钟允许提交的 Run 数；0 表示关闭限流。
RATE_LIMIT_RUNS_PER_MINUTE=60
# 任务流长度达到该水位时拒绝新提交（503 + Retry-After），应低于 TASK_STREAM_MAXLEN。
TASK_MAX_QUEUE_DEPTH=80000

# 收到 SIGTERM 后等待当前 Run 完成的最长时间；超时取消并留给重投递。
SHUTDOWN_TIMEOUT_SECONDS=60

# =============================================================================
# 五、Sandbox Provider
# =============================================================================

# Sandbox Provider 决定 Runtime 将 Agent 的命令执行交给哪里；Snapshot 不能自行提升或
# 切换部署级 Provider。docker 需要本机 Docker Daemon，kubernetes 需要集群权限，http
# 需要 SANDBOX_GATEWAY_BASE_URL，生产还要求 Gateway 使用 HTTPS 并配置独立 AK/SK。
# Sandbox 实现类型：
#   docker      通过 Docker CLI 创建临时容器；适合本地联调。
#   kubernetes  通过 kubectl 创建临时 Pod；适合生产集群。
#   http        调用任意实现通用 HTTP 契约的 Sandbox Gateway（默认）。
# Runtime 不得退化为宿主机 Shell 执行用户命令。
SANDBOX_PROVIDER=http

# SANDBOX_PROVIDER=http 时必填；docker/kubernetes 时留空。
SANDBOX_GATEWAY_BASE_URL=https://sandbox-gateway.example.com

# Runtime -> Sandbox Gateway 的独立 AK/SK，不得复用 Runtime 入站凭证。
# 使用 HTTP Gateway 时通过 Secret 注入；docker/kubernetes 模式可以留空。
SANDBOX_GATEWAY_ACCESS_KEY=runtime-sandbox-prod
SANDBOX_GATEWAY_SECRET_KEY=EXAMPLE_ONLY_sandbox_secret_replace_via_secret_manager

# Sandbox Gateway 建立连接超时，单位为秒。
SANDBOX_CONNECT_TIMEOUT_SECONDS=5

# Sandbox Gateway 读取响应超时，单位为秒。
SANDBOX_READ_TIMEOUT_SECONDS=90

# HMAC Sandbox Gateway 的旧 Token 兼容配置不再放入示例。新 Gateway 必须使用上面的 AK/SK。

# Docker CLI 配置，仅 SANDBOX_PROVIDER=docker 使用。生产应固定可信镜像 Digest。
DOCKER_BINARY=docker
DOCKER_DEFAULT_IMAGE=registry.example.com/agent-sandbox/python@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DOCKER_CONTROL_TIMEOUT_SECONDS=30

# Kubernetes 配置，仅 SANDBOX_PROVIDER=kubernetes 使用。
KUBECTL_BINARY=kubectl
KUBERNETES_NAMESPACE=data-agent-runtime
KUBERNETES_KUBECONFIG=/var/run/secrets/kubernetes.io/serviceaccount/kubeconfig
KUBERNETES_CONTEXT=prod-cluster
KUBERNETES_DEFAULT_IMAGE=registry.example.com/agent-sandbox/python@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
KUBERNETES_CONTROL_TIMEOUT_SECONDS=120

# =============================================================================
# 六、Run 执行限制
# =============================================================================

# 单次 Agent Run 最大图步骤/工具推理步数。
MAX_STEPS=20

# 单次 Run 总超时时间，单位为秒。
RUN_TIMEOUT_SECONDS=300

# Run 状态在 Redis 中的保留时间，单位为秒；604800 为 7 天。
RUN_STATE_TTL_SECONDS=604800

# =============================================================================
# 七、Skill Artifact 与 Workspace
# =============================================================================

# Skill Bundle 本地缓存和 Run 工作区。Runtime 进程必须具备读写权限。
SKILL_CACHE_DIR=/var/lib/data-agent-runtime/skill-cache
WORKSPACE_ROOT=/var/lib/data-agent-runtime/workspaces

# 下载 Skill Bundle 的超时时间，单位为秒。
SKILL_DOWNLOAD_TIMEOUT_SECONDS=30

# 可选的 Skill Artifact 下载 AK/SK。两项同时配置时，Runtime 使用
# DATA_AGENT-HMAC-SHA256 请求签名访问对象存储或 Artifact Gateway；两项均不配置时，
# 直接拉取公开 URL 或预签名 URL。Secret 必须通过 Secret Manager 注入。
SKILL_ARTIFACT_ACCESS_KEY=skill-artifact-prod
SKILL_ARTIFACT_SECRET_KEY=EXAMPLE_ONLY_skill_artifact_secret_replace_via_secret_manager

# Skill 压缩包最大大小，单位为字节；52428800 为 50 MiB。
SKILL_MAX_BUNDLE_BYTES=52428800

# Skill 解压后的最大总大小，单位为字节；用于防止压缩包炸弹。
SKILL_MAX_EXTRACTED_BYTES=209715200

# 单个 Skill Bundle 最大文件数。
SKILL_MAX_FILES=2000

# 非本地环境允许下载 Skill Bundle 的对象存储主机白名单，多个主机用逗号分隔。
# 生产必须配置；留空会拒绝远程 Bundle，防止 SSRF。
SKILL_ALLOWED_HOSTS=skills.example.com

# 是否允许本地开发从 localhost/127.0.0.1 使用 HTTP Bundle URL；只有 APP_ENV=local/
# dev/development 且目标 Host 为本机时生效，不会放行任意远程 HTTP。生产必须为 false，
# 并使用 HTTPS；PUBLIC_MODE=true 时仍需满足 Skill Artifact 的 bundle_url、sha256 和 Host 策略。
SKILL_ALLOW_HTTP_LOCAL=false

# =============================================================================
# 八、Redis Stream 任务队列与 Worker
# =============================================================================

# API Producer 写入、Worker Consumer Group 消费的任务 Stream；API 和所有 Worker 必须
# 使用同一个 TASK_STREAM_KEY，否则任务会进入不同队列而无法被预期的 Worker 消费。
TASK_STREAM_KEY=agent:prod:tasks

# 同一逻辑 Worker 集群必须使用同一个 Consumer Group，Redis 会在组内分配消息并维护
# Pending 状态；不同环境/租户应使用不同 Group，避免测试 Worker 消费生产任务。
TASK_CONSUMER_GROUP=data-agent-prod-workers

# 当前 Worker Consumer 名称；同一个 Consumer Group 内必须唯一，便于 Pending reclaim、
# 心跳和故障定位。API 进程不消费任务，不使用该值；多副本部署不能复用固定名称。
TASK_CONSUMER_NAME=worker-prod-01

# 任务 Stream 最大长度（近似裁剪），不能替代业务审计归档。
TASK_STREAM_MAXLEN=100000

# 超过最大重试次数后的死信 Stream。
TASK_DEAD_LETTER_STREAM_KEY=agent:prod:tasks:dead-letter

# Worker 阻塞等待新任务的时间，单位为毫秒；到期后执行心跳和 Pending reclaim。
TASK_BLOCK_MS=5000

# Pending 消息被其他 Worker reclaim 前的可见性超时时间，单位为秒。
# 应大于常规 Run 时长，过小会增加重复执行风险。
TASK_VISIBILITY_TIMEOUT_SECONDS=900

# 单个任务最大执行次数（包含首次执行）。
TASK_MAX_ATTEMPTS=3

# 失败任务重新入队前的等待时间，单位为秒。
TASK_RETRY_DELAY_SECONDS=5

# Worker Lease/心跳刷新间隔，单位为秒，应明显小于可见性超时时间。
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# 进程角色：api 只提供 HTTP 和入队接口；worker 只消费 Redis Stream 并执行 Agent；all
# 仅用于单进程本地联调。API 与 Worker 生产部署应分别设置角色，但必须共享 Redis、
# Checkpointer、TASK_STREAM_KEY 和 TASK_CONSUMER_GROUP；local-stack.sh 会独立启动 API/Worker。
RUNTIME_MODE=api

# =============================================================================
# 九、OpenTelemetry
# =============================================================================

# 是否启用 OpenTelemetry Trace。true 时还必须配置 OTEL_EXPORTER_OTLP_ENDPOINT（以及
# 需要时的 Header），否则会产生导出失败；false 不影响 Agent 业务执行，仅关闭 Trace。
OTEL_ENABLED=true

# API 与 Worker 建议使用相同的服务名，并通过 role 属性区分进程。
OTEL_SERVICE_NAME=data-agent-runtime

# OTLP HTTP Collector 地址，例如 http://otel-collector:4318；Runtime 会补充 /v1/traces。
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com

# OTLP Header，格式为 key=value,key2=value2；禁止提交真实 Token。
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer EXAMPLE_ONLY_otel_token_replace_via_secret_manager

# Trace 采样比例，范围 0～1；生产通常为 0.05～0.2。
OTEL_TRACE_SAMPLE_RATIO=0.1

# OTLP 导出超时时间，单位为秒。
OTEL_EXPORTER_TIMEOUT_SECONDS=10

# 是否允许 OTLP Exporter 使用非 TLS 连接；仅当 OTEL_ENABLED=true 且 Collector 地址为
# 本地 HTTP 时才相关。生产保持 false，并使用 HTTPS OTEL_EXPORTER_OTLP_ENDPOINT；设置为
# true 不会开启 Trace，必须同时设置 OTEL_ENABLED=true。
OTEL_INSECURE=false

# =============================================================================
# 十、公共 Snapshot Admission 策略
# =============================================================================

# Prompt 和 Snapshot 资源硬上限；最终生效值取 Snapshot、Principal 配额和部署上限的最小值。
MAX_PROMPT_CHARS=200000
MAX_SNAPSHOT_SKILLS=100
MAX_SNAPSHOT_MCP_SERVERS=50
MAX_SNAPSHOT_SUBAGENT_DEPTH=5
MAX_SNAPSHOT_TOOL_COUNT=200

# 允许的模型名称和 Provider，逗号分隔；留空表示不额外限制名称。Provider 必须同时
# 存在于 Runtime 内置适配器注册表（openai、openai-compatible、deepseek）中。
ALLOWED_MODEL_NAMES=gpt-4o-mini,deepseek-chat,deepseek-flash
ALLOWED_MODEL_PROVIDERS=openai,openai-compatible,deepseek

# MCP Host 白名单，逗号分隔。PUBLIC_MODE=true 时必须非空，Snapshot 中每个 MCP Host 都
# 必须命中白名单，且 localhost、loopback、私有网段仍会被拒绝；PUBLIC_MODE=false 时可按
# 本地/受控网络策略放宽，但不应把空白名单理解为允许任意外部地址。
ALLOWED_MCP_HOSTS=mcp-gateway.example.com,rag-gateway.example.com

# 异步子 Agent（远程 Agent Protocol 服务）的 Host 白名单，逗号分隔；
# PUBLIC_MODE=true 时必须非空，且仍然拒绝 localhost / 私网地址。
ALLOWED_SUBAGENT_HOSTS=agent-protocol.example.com

# MCP 服务端凭证注册表；Snapshot 只能携带 credential_ref，Runtime 在服务端解析 Header，
# 不允许调用方把 Authorization 等 Secret 内联进 Snapshot。PUBLIC_MODE=true 时尤其必须
# 使用 credential_ref，并且对应引用必须在这里注册。
MCP_CREDENTIALS_JSON='{"analytics-prod":{"headers":{"Authorization":"Bearer EXAMPLE_ONLY_mcp_token_replace_via_secret_manager"}}}'

# 是否允许 Snapshot 声明 stdio MCP；只有 PUBLIC_MODE=false 且处于受控环境时才可能生效。
# PUBLIC_MODE=true 时无条件禁止，因为 stdio 会让外部调用方影响 Runtime 所在主机的命令执行。
ALLOW_MCP_STDIO=false

# 是否允许 Snapshot 直接携带 Skill content。只有 PUBLIC_MODE=false 且调用方明确受信任时
# 才适合开启；PUBLIC_MODE=true 时无条件禁止，必须使用 bundle_url + sha256 的受控 Artifact，
# 并由 SKILL_ALLOWED_HOSTS、大小限制和摘要校验共同约束供应链风险。
ALLOW_INLINE_SKILLS=false

# 每个 Principal 的最大并发 Run 数。
MAX_CONCURRENT_RUNS_PER_PRINCIPAL=20

# Sandbox 资源上限，防止 Snapshot 放大资源消耗。
MAX_SANDBOX_TIMEOUT_SECONDS=3600
MAX_SANDBOX_OUTPUT_BYTES=50000000
MAX_SANDBOX_PROCESSES=10000
MAX_SANDBOX_CPU_LIMIT=64
MAX_SANDBOX_MEMORY_MB=262144
MAX_SANDBOX_DISK_MB=1048576

# 允许使用的 Sandbox 镜像白名单，多个镜像用逗号分隔；生产建议配置为可信镜像或 Digest。
ALLOWED_SANDBOX_IMAGES=registry.example.com/agent-sandbox/python@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# =============================================================================
# 十一、API / Worker 部署提示
# =============================================================================
# API：
#   RUNTIME_MODE=api uv run data-agent-runtime
# Worker：
#   RUNTIME_MODE=worker uv run data-agent-worker
# 本地联调也可以直接执行：./scripts/local-stack.sh start
#
# 生产最少需要：Redis、模型 API、HMAC AK/SK、HTTPS、受控 Sandbox（如启用）以及
# PostgreSQL Checkpointer（多 Worker/需要持久化 LangGraph 状态时）。
# 不要把注册表中的 Secret、SANDBOX_GATEWAY_SECRET_KEY、OPENAI_API_KEY、
# POSTGRES_DSN 密码或 INTERNAL_SERVICE_CREDENTIALS_JSON 中的 Secret 提交到 Git。
