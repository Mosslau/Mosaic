# ============================================================
# Data Agent Java Spring Boot 控制平面环境变量示例
# 复制为 .env 或由部署平台注入；不要把真实密码提交到 Git。
# ============================================================

# -------------------- HTTP 服务 --------------------
# Spring Boot 监听端口。
SERVER_PORT=8080
# 前端静态页面的本地来源；生产环境改为实际前端域名，多个域名用逗号分隔。
WEB_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# -------------------- Python DeepAgents Runtime --------------------
# Java 调用 Python Runtime 的内部地址。
PYTHON_RUNTIME_BASE_URL=http://127.0.0.1:8800
# Java -> Python Runtime 的 HMAC 身份；SK 只能由 Secret 注入，生产不可使用示例值。
INTERNAL_SERVICE_ACCESS_KEY=java-runtime-local
INTERNAL_SERVICE_SECRET_KEY=local-only-secret-change-me
# 仅本地迁移兼容，生产环境留空。
INTERNAL_SERVICE_TOKEN=local-browser-token
# Java Gateway inbound credentials (MCP / non-Sandbox internal endpoints).
GATEWAY_ACCESS_KEY=
GATEWAY_SECRET_KEY=
# Python Runtime -> Sandbox Gateway credentials.
SANDBOX_GATEWAY_ACCESS_KEY=runtime-sandbox-local
SANDBOX_GATEWAY_SECRET_KEY=local-only-sandbox-secret-change-me
# Runtime HTTP 连接建立和读取超时。
PYTHON_RUNTIME_CONNECT_TIMEOUT=3s
PYTHON_RUNTIME_READ_TIMEOUT=30s

# -------------------- Redis / SSE --------------------
# Java SSE Gateway 与 Python Runtime 必须访问同一个 Redis 实例和逻辑库。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Homebrew 默认 requirepass=root 时填写 root；无密码则留空。
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s

# -------------------- 控制面 PostgreSQL --------------------
# memory：本地快速开发，重启丢失控制面数据；postgres：推荐的持久化模式。
AGENT_PERSISTENCE_MODE=memory
# PostgreSQL JDBC 地址，不是 Python 的 postgresql:// URI。
POSTGRES_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=10

# -------------------- Java Sandbox Gateway --------------------
# Gateway 契约开关。开发阶段建议 false，Python 本地 Sandbox 使用 SANDBOX_PROVIDER=docker。
JAVA_SANDBOX_GATEWAY_ENABLED=false
# 仅在接入受控 Docker/Kubernetes Provider、策略和审计后开启；当前实现默认拒绝执行。
JAVA_SANDBOX_COMMAND_EXECUTION_ENABLED=false
