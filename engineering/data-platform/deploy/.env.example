# Mosaic 本地 compose 覆盖示例
# 用法: cp deploy/.env.example deploy/.env  (deploy/.env 已 gitignore, 不进库)
#
# 宿主 MQTT 端口: 本机 1883 常被 RabbitMQ MQTT 插件等占用, 占用时改用 11883
# (判据与处置见 deploy/README Q10; 改后模拟器用 -broker tcp://localhost:11883)
EMQX_MQTT_PORT=11883
# EMQX Dashboard 密码(默认 public; 生产/共享网络务必改)
# EMQX_DASHBOARD_PASSWORD=change-me

# 宿主 MySQL/Redis 端口: 3306/6379 常被本机或公司已有实例占用, 故默认避让为 13306/16379
# (容器间通信用服务名 + 原生端口: mysql:3306 / redis:6379, 不受这两项影响)
# MYSQL_HOST_PORT=13306
# REDIS_HOST_PORT=16379
# 库口令(仅本地开发默认值; 共享/生产环境必须改)
# MYSQL_ROOT_PASSWORD=ov_root_2026
# MYSQL_PASSWORD=ov_app_2026
