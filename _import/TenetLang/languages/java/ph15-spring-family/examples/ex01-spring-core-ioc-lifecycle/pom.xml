<?xml version="1.0" encoding="UTF-8"?>
<!-- examples/ex01-spring-core-ioc-lifecycle/pom.xml —— Spring Core IOC/DI 容器（不依赖 Web，纯核心容器）
     验证环境：OpenJDK 17.0.18 + Maven 3.9.12 + Spring Framework 6.1.8（Boot 3.3.0 父 POM 管理版本）
     验证命令：mvn -o -Dmaven.repo.local=/tmp/m2clone test
     离线说明：本机缓存缺 junit-platform-launcher 1.10.2（Spring Boot 3.3.0 默认版本，缓存只有 1.10.1），
               pom 显式压到缓存里有的 1.10.1；surefire 3.2.5 在 pom 里显式钉住（缓存缺默认版本）。
               正常联网环境可删掉这些「离线版本仲裁」并让父 POM 自己管理。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>ex01-spring-core-ioc-lifecycle</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 离线版本仲裁：缓存只有 junit-platform-launcher 1.10.1 -->
      <dependency>
        <groupId>org.junit.platform</groupId>
        <artifactId>junit-platform-launcher</artifactId>
        <version>1.10.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- 纯 Spring Core：容器/DI/生命周期都在 spring-context（不引 starter-web，本示例无 Web） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- @PostConstruct/@PreDestroy 注解（jakarta.annotation，Spring 6 起用 jakarta 命名空间；版本由父 POM 管） -->
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <dependencies>
          <!-- 离线版本仲裁：surefire 的 junit-platform provider 需要 launcher，钉到缓存有的版本 -->
          <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.1</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
