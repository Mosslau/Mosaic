# ============================================================
# MindSpring .gitignore
# 原则：只忽略"可再生的产物"（编译/缓存/环境/密钥），源码与文档一律入库。
# 无前导 / 的模式在任意层级生效；有前导 / 的只在仓库根级生效。
# ============================================================

# ---------- Python 编译产物 ----------
__pycache__/
*.py[codz]
*$py.class
*.so

# ---------- Python 打包/分发产物（仅根级，避免误吞子项目源码目录） ----------
.Python
/build/
/dist/
*.egg
*.egg-info/
wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
*.manifest
*.spec

# ---------- Rust ----------
# Cargo 构建产物。tutorials/rust 是子目录里的 Cargo workspace，
# target/ 必须保持任意层级生效，不能收窄为根级。
target/

# ---------- 测试 / 覆盖率 / 静态检查缓存 ----------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.cache
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ---------- 虚拟环境 ----------
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ---------- 密钥 / 本地配置（防泄密） ----------
.env
.envrc
.pypirc
.streamlit/secrets.toml

# ---------- Jupyter ----------
.ipynb_checkpoints

# ---------- 日志 ----------
*.log

# ---------- 文档构建产物 ----------
docs/_build/
/site

# ---------- 系统与工具 ----------
.DS_Store
.workbuddy

# ---------- MindSpring 实验产物 ----------
# 实验运行输出与数据缓存可重新生成，不入库。
**/outputs/
**/data/cache/
